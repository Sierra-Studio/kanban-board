# SQLAlchemy database URL (SQLite)
DATABASE_URL="sqlite:///./kanban.db"

# Secret used to derive/verify auth material. Use a long random string.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-min-32-characters-long"

# Comma-separated list of allowed browser origins (the Next.js app)
CORS_ORIGINS="http://localhost:3000"

# Session cookie configuration
SESSION_COOKIE_NAME="kanban_session"
SESSION_EXPIRES_DAYS=7
# Set to true when serving over HTTPS
COOKIE_SECURE=false

# development | test | production
ENVIRONMENT="development"
