# Root environment for docker compose (copy to .env). Compose auto-loads this file.
#
# NOTE: API configuration (AUTH_SECRET, CORS_ORIGINS, sessions, etc.) now lives in
# ./api/.env, which the compose "api" service loads via env_file. This root file only
# holds variables consumed by docker-compose.yml itself (the web build/runtime).

# Browser-facing URL of the API (must be reachable from the user's browser).
# This is baked into the web client bundle at build time.
PUBLIC_API_URL="http://localhost:8000"
